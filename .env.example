# freqdash configuration. Copy to `.env` (never commit it) and fill in the blanks.
# compose loads it with `env_file`. Keep comments on their own lines: values must not carry trailing comments.
# Avoid `$` in values (compose interpolates it) or wrap the value in single quotes.

# --- Docker (required) ---
# The existing Docker network your freqtrade bot containers are on (`docker network ls`); compose attaches freqdash to
# it so it can reach the bots by container name. Bots on another network or host: create one with
# `docker network create freqdash`, use that, and point FT_BOT_n_URL at an address freqdash can reach.
BOT_NETWORK=

# --- Auth (required) ---
# Sign-in uses user accounts stored in the database. The first start creates `admin` with a random temporary password
# printed once in `docker logs freqdash` (README section 5). DASHBOARD_PASSWORD is retired: remove it from an existing .env.
# Key that encrypts the secrets stored in the database (the assistant's API key, generated Web Push keys). At least 32
# characters, e.g. `openssl rand -base64 48`. Rotating it signs nobody out, but the assistant key must be entered again
# and (with generated push keys) every device must re-enable notifications.
SESSION_SECRET=
# Optional. Read-only bearer token for automation (GET /api/v1/* only). At least 32 characters; leave empty to disable.
AGENT_API_TOKEN=
# A session ends after this many days without use (every use extends it), and after 90 days (or this, if longer) in any case.
SESSION_MAX_AGE_DAYS=30
# auto | true | false. `auto` sets Secure only when X-Forwarded-Proto is https, so plain LAN http still works.
COOKIE_SECURE=auto
# Comma-separated origins allowed to send mutating requests, besides the request's own Host.
APP_ORIGINS=http://localhost:8043
# Optional, used for links in notifications.
APP_PUBLIC_URL=
# none | cloudflare (trust cf-connecting-ip for rate limiting). Use cloudflare only behind Cloudflare.
TRUST_PROXY=none
# Add an account or reset a password: set both, restart, sign in with this (temporary) password, choose a new one, then
# clear both. A username that does not exist yet is created. Set before the very first start, it replaces `admin`.
AUTH_RESET_USER=
AUTH_RESET_PASSWORD=

# --- Bots (1..10) ---
# One block per bot. Delete the blocks you do not use. URL: the bot's api_server as seen from this container (same
# Docker network). LOGFILE: path inside this container; compose mounts the host log directory at /ftlogs.
# Freqtrade has no read-only API role: freqdash only ever sends GET requests, but these credentials can control the bot.
FT_BOT_1_ID=bot1
FT_BOT_1_NAME=Bot1
FT_BOT_1_URL=http://freqtrade-bot1:8080
FT_BOT_1_USERNAME=
FT_BOT_1_PASSWORD=
FT_BOT_1_LOGFILE=/ftlogs/bot1.log
FT_BOT_1_CONTAINER=freqtrade-bot1
FT_BOT_1_COLOR=#4F8CFF
FT_BOT_2_ID=bot2
FT_BOT_2_NAME=Bot2
FT_BOT_2_URL=http://freqtrade-bot2:8080
FT_BOT_2_USERNAME=
FT_BOT_2_PASSWORD=
FT_BOT_2_LOGFILE=/ftlogs/bot2.log
FT_BOT_2_CONTAINER=freqtrade-bot2
FT_BOT_2_COLOR=#B38CFF

# --- Kraken READ-ONLY key (optional: without it freqdash runs in freqtrade-only mode) ---
# Create a NEW key with only: Query Funds, Query open orders & trades, Query closed orders & trades and Query ledger
# entries (the ledger prices manual holdings). NEVER reuse the bots' trading key.
KRAKEN_API_KEY=
KRAKEN_API_SECRET=
KRAKEN_API_BASE_URL=https://api.kraken.com
# starter | intermediate | pro (API rate-limit tier of the account).
KRAKEN_TIER=starter
# ISO 8601 start of reconciliation. Empty: the time of freqdash's first start, so older Kraken orders are never
# checked. Set it to before your bots' first trade to reconcile their whole history.
RECON_START=

# --- Notifications (optional) ---
DISCORD_WEBHOOK_URL=
# info | warning | critical
NOTIFY_MIN_SEVERITY=warning
# Web Push (VAPID). Leave both empty to generate a key pair on first start (stored encrypted in the database).
# Changing the keys invalidates every device: each one must enable notifications again.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact for the push services (mailto: or https:). Default: APP_PUBLIC_URL when it is https.
VAPID_SUBJECT=

# --- Runtime ---
POLLER_ENABLED=true
LOG_BACKFILL_HOURS=96
# debug | info | warn | error
LOG_LEVEL=info
# Where the SQLite database lives. compose sets /data (a named volume); default is ./data.
# DATA_DIR=./data

# --- Killswitch (optional). Stops the bots' containers when Kraken shows a runaway buyer. -----------------------
# off | dry-run | armed. Start with dry-run: it alerts but stops nothing. Needs the Kraken key above.
KILLSWITCH_MODE=off
# Trips on MORE than this many buys of one pair within 30 s, or within 10 min.
KILLSWITCH_MAX_BUYS_30S=2
KILLSWITCH_MAX_BUYS_10M=3
# The agent (compose service killswitch-agent). The token is shared by freqdash and the agent: 24+ random characters.
KILLSWITCH_AGENT_URL=http://freqdash-killswitch:9100
KILLSWITCH_TOKEN=
# Containers the agent may stop, comma separated. Must match the FT_BOT_n_CONTAINER values. While this and the token
# are both empty the agent idles and does nothing.
KILLSWITCH_ALLOWED=
