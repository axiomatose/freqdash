# Development / test configuration. Every value is a dummy for the local mock upstreams
# (`npm run mock`, http://localhost:9999). Nothing here is a real credential.
# Copy to `.env.local` for `npm run dev`. `docker run --env-file` does not strip trailing comments, so there are none.

SESSION_SECRET=dev-only-session-secret-0123456789-abcdef
SESSION_MAX_AGE_DAYS=30
COOKIE_SECURE=auto
APP_ORIGINS=http://localhost:3000,http://localhost:8043
APP_PUBLIC_URL=
TRUST_PROXY=none
# First account for the dev database and the e2e run (created on first start, must be changed at first sign-in).
AUTH_RESET_USER=admin
AUTH_RESET_PASSWORD=dev-only-admin-password

FT_BOT_1_ID=votemax
FT_BOT_1_NAME=VoteMax
FT_BOT_1_URL=http://localhost:9999/votemax
FT_BOT_1_USERNAME=mock-votemax-user
FT_BOT_1_PASSWORD=mock-votemax-pass
FT_BOT_1_LOGFILE=./test/mock-upstreams/.run/votemax.log
FT_BOT_1_COLOR=#4F8CFF
FT_BOT_2_ID=dca
FT_BOT_2_NAME=DCA
FT_BOT_2_URL=http://localhost:9999/dca
FT_BOT_2_USERNAME=mock-dca-user
FT_BOT_2_PASSWORD=mock-dca-pass
FT_BOT_2_LOGFILE=./test/mock-upstreams/.run/dca.log
FT_BOT_2_COLOR=#B38CFF

KRAKEN_API_KEY=DEVONLYMOCKKRAKENAPIKEY000000000000000000000000000000000
KRAKEN_API_SECRET=ZGV2LW9ubHktbW9jay1rcmFrZW4tc2VjcmV0LW5vdC1hLXJlYWwta2V5LS0tLS0tLS0tLS0tLS0tLS0tLS0tLQ==
KRAKEN_API_BASE_URL=http://localhost:9999/kraken
KRAKEN_TIER=starter
RECON_START=

DISCORD_WEBHOOK_URL=http://localhost:9999/discord/webhook
NOTIFY_MIN_SEVERITY=warning

POLLER_ENABLED=false
LOG_BACKFILL_HOURS=96
LOG_LEVEL=info
